/**
 * 1-bit register:
 * If load[t] == 1 then out[t+1] = in[t]
 *                 else out does not change (out[t+1] = out[t])
 */

CHIP Bit {
    IN in, load;
    OUT out;

    PARTS:
// Put your code here:
    Mux(a=out_old, b=in, sel=load, out=dff_in);
    
    DFF(in=dff_in, out=out, out=out_old);

}
